# Nebius Token Factory (OpenAI-compatible). Leave NEBIUS_API_KEY empty to run in MOCK mode.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model routing: fast = many small extraction calls, mid = judging, deep = cross-source reasoning (one call)
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_MID=nvidia/nemotron-3-super-120b-a12b
MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b
# Tavily (page extraction + search). Leave empty to fetch pages directly (or use fixtures in MOCK mode).
TAVILY_API_KEY=
# Optional: GitHub token only raises the API rate limit; public repos work without it.
GITHUB_TOKEN=
PORT=3456

# Public deployment (Vercel sets VERCEL automatically): MOCK by default. LIVE only with ALL of these:
# FINEPRINT_ENABLE_LIVE=1
# FINEPRINT_DEMO_TOKEN=<16+ char secret, sent by the operator as x-demo-token>
# BLOB_READ_WRITE_TOKEN=<Vercel Blob private store token; global spend ledger>
# FINEPRINT_LEDGER_CAP_USD=0.75

# Public deployments require all live gate values; never publish real secrets.
FINEPRINT_ENABLE_LIVE=0
FINEPRINT_DEMO_TOKEN=
BLOB_READ_WRITE_TOKEN=
FINEPRINT_LEDGER_CAP_USD=0.65
LIMIT_REQUEST_TIMEOUT_MS=220000
NEBIUS_ENABLE_THINKING=0
